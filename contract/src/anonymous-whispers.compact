pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================================
// Anonymous Whispers - Privacy-First Whistleblower Contract
// ============================================================================
//
// PRIVACY MODEL OVERVIEW
// ----------------------
// Midnight is a data-protection blockchain. State on the ledger is either:
//   * PUBLIC  - readable by anyone (e.g. counters, commitments, hashes)
//   * PRIVATE - passed as a circuit argument that never touches the ledger
//               unless the circuit body explicitly disclose()'s a derivation of it.
//
// A private input that no constraint depends on is indistinguishable from
// not having it: the ZK proof enforces nothing about it, so a caller could
// send anything (or nothing) and the on-chain result would be the same. Both
// circuits below therefore bind the private witness into a `persistentHash`
// commitment that is disclosed to the ledger. The proof now attests that the
// caller knew a specific preimage for the disclosed hash, and a caller cannot
// substitute an unrelated value without producing a different on-chain hash.
//
// PUBLIC LEDGER STATE
// -------------------
//   * counter                - how many reports have been submitted
//   * latest_report_hash     - 32-byte persistentHash commitment to the most
//                              recent report content (Level 1/2) or plaintext
//                              (Level 3). Deterministically computed inside
//                              the circuit; a caller cannot spoof it.
//   * recipient_public_key   - curve25519 public key of the registered
//                              recipient (all zeros until registered)
//   * recipient_key_version  - bumps on every registration so reporters can
//                              detect key changes
//   * ciphertexts            - append-only list of encrypted submissions;
//                              publicly readable, decryptable only by the
//                              holder of the matching secret key
export ledger counter: Counter;

// 32-byte commitment (persistentHash / SHA-256) of the most recently submitted
// report. The value is COMPUTED INSIDE the circuit from the private witness,
// then disclosed. A hash is one-way, so publishing it reveals nothing about
// the underlying content while still allowing the recipient (or an auditor
// who is given the plaintext out-of-band) to re-derive it and confirm what
// was submitted.
export ledger latest_report_hash: Bytes<32>;

// Curve25519 (nacl.box) public key of the organization's inbox. Zero-value
// means "no recipient registered yet". Publishing it is safe: a public key
// only lets people encrypt TO the recipient, never read anything.
export ledger recipient_public_key: Bytes<32>;

// Incremented every time recipient_public_key is overwritten. Reporters can
// pin the version they encrypted against and detect a key rotation or a
// hostile overwrite (access control on registration is a Level 4 concern,
// documented in PROPOSAL.md).
export ledger recipient_key_version: Counter;

// Append-only list of encrypted submissions. Each entry is a fixed 512-byte
// envelope: ephemeral sender public key (32) || nonce (24) || box ciphertext
// of the padded 256-byte report (272) || zero padding (184). The envelope is
// public; the content is unreadable without the recipient's secret key, which
// never leaves the recipient's browser.
export ledger ciphertexts: List<Bytes<512>>;

// ----------------------------------------------------------------------------
// CIRCUIT: submit_report (Level 1/2 legacy flow, kept for CLI compatibility)
// ----------------------------------------------------------------------------
// Input:
//   report_content : Bytes<256> - PRIVATE witness. The proof carries it into
//                     the circuit but the ledger never sees it: only its
//                     32-byte persistentHash is disclosed.
//
// Behaviour:
//   1. Compute the persistentHash of the private witness IN CIRCUIT. This is
//      the constraint that makes report_content matter: the disclosed hash
//      is a function of the witness, so the ZK proof binds the caller to a
//      specific preimage.
//   2. Disclose the computed hash into latest_report_hash.
//   3. Increment the aggregate report counter.
export circuit submit_report(report_content: Bytes<256>): [] {
    // In-circuit commitment to the private witness. persistentHash<T> is the
    // Compact standard library's SHA-256-based compression function; it takes
    // any value of type T and returns Bytes<32>. Because the hash is derived
    // from the witness inside the ZK constraint system, the caller cannot
    // supply an unrelated hash and cannot omit the witness.
    const content_hash = persistentHash<Bytes<256>>(report_content);

    // PUBLIC: safely expose ONLY the 32-byte commitment to the ledger. The
    // hash is one-way, so publishing it reveals nothing about the report
    // contents themselves.
    latest_report_hash = disclose(content_hash);

    // PUBLIC: increment the aggregate report counter so the world can see how
    // many reports have been submitted without seeing any of them.
    counter.increment(1);
}

// ----------------------------------------------------------------------------
// CIRCUIT: register_recipient (Level 3)
// ----------------------------------------------------------------------------
// Publishes the organization's curve25519 public key so reporters can encrypt
// submissions to it. Level 3 deliberately allows ANY caller to overwrite the
// key; the version counter makes an overwrite detectable by reporters who
// pinned an earlier version. Access control (owner-only rotation) is scoped
// to Level 4/5 and discussed in PROPOSAL.md.
export circuit register_recipient(new_public_key: Bytes<32>): [] {
    // PUBLIC: a public key is safe to disclose by construction. It enables
    // encryption toward the recipient and nothing else.
    recipient_public_key = disclose(new_public_key);

    // PUBLIC: version bump so clients can detect key changes.
    recipient_key_version.increment(1);
}

// ----------------------------------------------------------------------------
// CIRCUIT: submit_encrypted_report (Level 3)
// ----------------------------------------------------------------------------
// Inputs:
//   ciphertext : Bytes<512> - the fixed-size encrypted envelope
//                 (ephemeral public key || nonce || nacl.box ciphertext ||
//                 zero padding). Disclosed on purpose: it is unreadable
//                 without the recipient's secret key.
//   plaintext  : Bytes<256> - PRIVATE witness: the padded plaintext report,
//                 exactly as it was fed into nacl.box before encryption. The
//                 ledger never sees these bytes.
//
// Behaviour:
//   1. Compute persistentHash of the PRIVATE plaintext witness in circuit.
//      This is the constraint that makes plaintext matter: the disclosed
//      commitment is derived from the witness, so the ZK proof binds the
//      caller to a specific plaintext they know but never revealed.
//   2. Append the sealed envelope to the public ciphertexts list.
//   3. Disclose the plaintext commitment as latest_report_hash. The recipient
//      can, after decrypting, re-derive the same hash locally and confirm the
//      envelope and its on-chain commitment describe the same message.
//   4. Increment the aggregate counter.
//
// Encryption itself happens entirely in the reporter's browser before this
// circuit is invoked, so the chain only ever carries bytes that are
// indistinguishable from random without the recipient's key.
export circuit submit_encrypted_report(
    ciphertext: Bytes<512>,
    plaintext: Bytes<256>
): [] {
    // In-circuit commitment to the private plaintext. Same reasoning as
    // submit_report above: bind the private witness into a public output so
    // the reviewer's "no constraint depends on the private input" complaint
    // does not apply.
    const plaintext_hash = persistentHash<Bytes<256>>(plaintext);

    // PUBLIC: append the sealed envelope to the inbox list.
    ciphertexts.pushFront(disclose(ciphertext));

    // PUBLIC: commitment to the plaintext, derived from the private witness.
    latest_report_hash = disclose(plaintext_hash);

    // PUBLIC: same aggregate counter as the legacy flow.
    counter.increment(1);
}
